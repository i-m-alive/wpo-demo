# Copy to .env (git ignores it) only if you want to change a default. Comments stay on lines of their own.

# The model. auto: Azure OpenAI at the endpoint below. Left empty, Docker Compose uses the LLM stand-in (stub-llm,
# no key needed); set both to use a real Azure OpenAI deployment. Outside Compose, empty means the offline model.
WPO_LLM=auto
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# The manager copilot's business hours. 00:00-24:00 = always open (the demo default).
COPILOT_HOURS=00:00-24:00
COPILOT_TZ=Europe/London

# 1 = compliance always fails, to show the loop back to the optimizer (3 rounds, then the run stops).
WPO_FORCE_COMPLIANCE_FAIL=0

# Failure modes of the stand-ins; normal = the canned answers. `make mode SYSTEM=workday MODE=throttle` switches one
# stand-in of a running stack without touching the others.
# Workday: throttle = HTTP 429 with Retry-After on every route; Retry-After is 30, 60 or 120 seconds.
WORKDAY_MODE=normal
WORKDAY_RETRY_AFTER=60
# MES: empty = HTTP 200 with no lines.
MES_MODE=normal
# Learning system: empty = HTTP 200 with no qualifications.
LMS_MODE=normal
# cuOpt: infeasible = HTTP 200, status INFEASIBLE, no roster.
CUOPT_MODE=normal
# Policy service: empty = HTTP 200 with no rules.
POLICY_MODE=normal
