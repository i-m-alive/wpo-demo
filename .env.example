# Copy to .env (git ignores it) only if you want the agents to use a real Azure OpenAI deployment.
# auto: Azure OpenAI when the endpoint and key below are set, the offline model when they are not.
WPO_LLM=auto
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# The manager copilot's business hours. 00:00-24:00 = always open (the demo default).
COPILOT_HOURS=00:00-24:00
COPILOT_TZ=Europe/London

# 1 = compliance always fails, to show the loop back to the optimizer (3 rounds, then the run stops).
WPO_FORCE_COMPLIANCE_FAIL=0
